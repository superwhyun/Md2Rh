      "marginTop": "1rem",
      "marginBottom": "0.5rem",
      "lineHeight": "1.4"
    },
    "p": {
      "marginTop": "0",
      "marginBottom": "0.75rem",
      "lineHeight": "1.5"
    },
    "blockquote": {
      "margin": "1rem 0",
      "padding": "0.75rem 1rem",
      "borderLeft": "2px solid #cccccc",
      "backgroundColor": "#fafafa",
      "fontStyle": "normal",
      "color": "#666666"
    },
    "ul": {
      "margin": "0.75rem 0",
      "paddingLeft": "0"
    },
    "ol": {
      "margin": "0.75rem 0",
      "paddingLeft": "0"
    },
    "li": {
      "marginBottom": "0.25rem",
      "lineHeight": "1.5"
    },
    "code": {
      "fontFamily": "'SF Mono', 'Monaco', 'Inconsolata', monospace",
      "fontSize": "0.875rem",
      "backgroundColor": "#f5f5f5",
      "color": "#333333",
      "padding": "0.2rem 0.3rem",
      "borderRadius": "0.2rem"
    },
    "pre": {
      "fontFamily": "'SF Mono', 'Monaco', 'Inconsolata', monospace",
      "fontSize": "0.875rem",
      "backgroundColor": "#f8f8f8",
      "color": "#333333",
      "padding": "1rem",
      "borderRadius": "0.25rem",
      "overflow": "auto",
      "margin": "1rem 0",
      "border": "1px solid #e8e8e8"
    },
    "strong": {
      "fontWeight": "600",
      "color": "#333333"
    },
    "em": {
      "fontStyle": "italic",
      "color": "#666666"
    },
    "a": {
      "color": "#007acc",
      "textDecoration": "none",
      "borderBottom": "1px solid #007acc"
    },
    "table": {
      "borderCollapse": "collapse",
      "width": "100%",
      "margin": "1rem 0",
      "fontFamily": "'Helvetica Neue', Arial, sans-serif",
      "fontSize": "0.95rem"
    },
    "th": {
      "border": "1px solid #e8e8e8",
      "padding": "0.75rem",
      "backgroundColor": "#f8f8f8",
      "fontWeight": "500",
      "textAlign": "left",
      "verticalAlign": "middle",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "#e8e8e8",
      "fontFamily": "'Helvetica Neue', Arial, sans-serif",
      "fontSize": "0.95rem",
      "color": "#333333"
    },
    "td": {
      "border": "1px solid #e8e8e8",
      "padding": "0.75rem",
      "backgroundColor": "#ffffff",
      "fontWeight": "normal",
      "textAlign": "left",
      "verticalAlign": "middle",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "#e8e8e8",
      "fontFamily": "'Helvetica Neue', Arial, sans-serif",
      "fontSize": "0.95rem",
      "color": "#333333"
