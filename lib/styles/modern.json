{
  "id": "modern",
  "name": "모던(MODERN) 스타일",
  "headingNumbering": {
    "h1": "number",
    "h2": "korean",
    "h3": "parenthesis",
    "h4": "number",
    "h5": "none"
  },
  "listCustomization": {
    "ulLevels": [
      {
        "marker": "□",
        "fontSize": "1rem",
